# ---------------------------------------------------------------------------
# App / Auth
# ---------------------------------------------------------------------------
JWT_SECRET=random_secret
NEXT_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Farcaster Mini App manifest (builders-garden starter)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FARCASTER_HEADER="string"
NEXT_PUBLIC_FARCASTER_PAYLOAD="string"
NEXT_PUBLIC_FARCASTER_SIGNATURE="string"

# ---------------------------------------------------------------------------
# Neynar (cast webhooks, reply publishing)
# ---------------------------------------------------------------------------
NEYNAR_API_KEY="string"
NEYNAR_WEBHOOK_SECRET="string"

# Managed-signer UUID for publishing `@commodus` replies. Provisioned once
# per FID via the Neynar dashboard. Required for the reply publisher.
NEYNAR_SIGNER_UUID=""

# Farcaster FID of the Commodus bot account. Used by the Neynar webhook
# `mentioned_fids` filter and by the reply-publishing flow to identify the bot.
COMMODUS_FID=""

# ---------------------------------------------------------------------------
# Upstash Redis (webhook idempotency, rate limits, session state)
# ---------------------------------------------------------------------------
# Auto-injected by the Vercel-Upstash marketplace integration.
# Pull locally with `vercel env pull .env.local`.
KV_REST_API_URL="https://<your-db>.upstash.io"
KV_REST_API_TOKEN="string"

# ---------------------------------------------------------------------------
# Supabase (Victus project: rjiecbvxrlctmoblqngt, us-east-2, Postgres 17)
# ---------------------------------------------------------------------------
# Public (safe to expose to the browser). Use with the supabase-js client
# in RSC/Server Actions for RLS-gated reads, if/when we add read policies.
NEXT_PUBLIC_SUPABASE_URL="https://rjiecbvxrlctmoblqngt.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Server-only. Bypasses RLS — ONLY import from server code
# (API routes, Vercel Workflow steps, server actions). Never ship to client.
# Copy from: https://supabase.com/dashboard/project/rjiecbvxrlctmoblqngt/settings/api
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# ---------------------------------------------------------------------------
# Privy (custodial arena wallets)
# ---------------------------------------------------------------------------
# Privy app id + app secret for the server-wallet REST API. Wallets are
# created lazily at gladiator-mint time; private keys are TEE-custodied
# inside AWS Nitro Enclaves and not extractable by the application server.
# See https://docs.privy.io/guide/server-wallets.
PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# Base-mainnet EOA that receives fee-on-swap transfers from arena wallets.
# Configure the same wallet in the Privy dashboard as the gas-sponsorship
# top-up destination so fees self-refill the sponsorship balance.
OPERATOR_TREASURY_ADDRESS="0x0000000000000000000000000000000000000000"

# ---------------------------------------------------------------------------
# 0x Swap API (DEX routing on Base)
# ---------------------------------------------------------------------------
# Used at execution time for quote + calldata that Privy submits
# (see #8 and #12). Also used at score time as a reference quote for the
# price-impact check.
ZEROX_API_KEY="string"

# ---------------------------------------------------------------------------
# OpenAI (command parsing fallback via Vercel AI SDK)
# ---------------------------------------------------------------------------
OPENAI_API_KEY="string"

# ---------------------------------------------------------------------------
# Chain / protocol
# ---------------------------------------------------------------------------
BASE_RPC_URL="https://mainnet.base.org"
GLORY_TOKEN_ADDRESS="0x0000000000000000000000000000000000000000"
MONTHLY_GLORY_POOL="0"

